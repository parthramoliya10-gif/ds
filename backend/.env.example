# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:3000

# ==========================================
# DATABASE (Supabase PostgreSQL + Prisma)
# ==========================================
# Connection pooling URL (for general queries)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"
# Direct connection URL (for Prisma migrations)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ==========================================
# SUPABASE AUTH & SERVICE
# ==========================================
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# ==========================================
# UPSTASH REDIS (Rate Limiting & Caching)
# ==========================================
UPSTASH_REDIS_REST_URL="https://[YOUR-REDIS-ENDPOINT].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ==========================================
# CLOUDINARY (Private Document Storage)
# ==========================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ==========================================
# RAZORPAY PAYMENT GATEWAY
# ==========================================
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# ==========================================
# RESEND (Email Notifications)
# ==========================================
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="support@yourdomain.com"
