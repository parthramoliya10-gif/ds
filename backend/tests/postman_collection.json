{
  "info": {
    "_postman_id": "c1f7b8d2-4321-4f9e-a0e2-9d8e7f6a5b4c",
    "name": "Document Service Management System API",
    "description": "Production-grade REST API collection for Document Service Management System with Supabase Auth, Razorpay 50-50 milestones, and Cloudinary private storage.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "YOUR_USER_SUPABASE_JWT_TOKEN",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "YOUR_ADMIN_SUPABASE_JWT_TOKEN",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        }
      }
    },
    {
      "name": "1. Authentication & Profile",
      "item": [
        {
          "name": "Google OAuth Login URL",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "google"]
            }
          }
        },
        {
          "name": "Establish HttpOnly Session (OAuth Callback)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"OAUTH_CALLBACK_CODE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "session"]
            }
          }
        },
        {
          "name": "Send Email OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"fullName\": \"Gautam Maurya\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp/send",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp", "send"]
            }
          }
        },
        {
          "name": "Verify Email OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"token\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/otp/verify",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "otp", "verify"]
            }
          }
        },
        {
          "name": "Forgot Password (Email Link)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Logout (Clear HttpOnly Cookies)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Update Current Profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Gautam Maurya\",\n  \"phone\": \"+919876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Admin: Update User Role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/users/:userId/role",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin", "users", ":userId", "role"],
              "variable": [
                {
                  "key": "userId",
                  "value": "TARGET_USER_UUID"
                }
              ]
            }
          }
        },
        {
          "name": "Admin: Suspend / Unblock User",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isBlocked\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/users/:userId/status",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin", "users", ":userId", "status"],
              "variable": [
                {
                  "key": "userId",
                  "value": "TARGET_USER_UUID"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Document Requests",
      "item": [
        {
          "name": "Submit New Request (with Reference Files)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Passport Apostille & Verification",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Need fast verification and apostille translation for visa application.",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Legal / Apostille",
                  "type": "text"
                },
                {
                  "key": "priority",
                  "value": "HIGH",
                  "type": "text"
                },
                {
                  "key": "referenceFiles",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/requests",
              "host": ["{{baseUrl}}"],
              "path": ["requests"]
            }
          }
        },
        {
          "name": "List Requests (User: own, Admin: all)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["requests"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Request by ID (Strict IDOR Check)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/:id",
              "host": ["{{baseUrl}}"],
              "path": ["requests", ":id"],
              "variable": [{ "key": "id", "value": "REQUEST_UUID" }]
            }
          }
        },
        {
          "name": "Admin: Update Request Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/requests/:id/status",
              "host": ["{{baseUrl}}"],
              "path": ["requests", ":id", "status"],
              "variable": [{ "key": "id", "value": "REQUEST_UUID" }]
            }
          }
        },
        {
          "name": "User: Cancel PENDING Request",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/requests/:id",
              "host": ["{{baseUrl}}"],
              "path": ["requests", ":id"],
              "variable": [{ "key": "id", "value": "REQUEST_UUID" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Quotations (50-50 Split)",
      "item": [
        {
          "name": "Admin: Create Quotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"REQUEST_UUID\",\n  \"totalAmount\": 1500,\n  \"estimatedDays\": 3,\n  \"terms\": \"50% upfront to commence apostille; remaining 50% upon completed document upload.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotations",
              "host": ["{{baseUrl}}"],
              "path": ["quotations"]
            }
          }
        },
        {
          "name": "Get Quotations for Request",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotations/request/:requestId",
              "host": ["{{baseUrl}}"],
              "path": ["quotations", "request", ":requestId"],
              "variable": [{ "key": "requestId", "value": "REQUEST_UUID" }]
            }
          }
        },
        {
          "name": "User: Accept Quotation (Triggers 50% Advance Order)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotations/:id/accept",
              "host": ["{{baseUrl}}"],
              "path": ["quotations", ":id", "accept"],
              "variable": [{ "key": "id", "value": "QUOTATION_UUID" }]
            }
          }
        },
        {
          "name": "User: Reject Quotation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Price is higher than expected.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/quotations/:id/reject",
              "host": ["{{baseUrl}}"],
              "path": ["quotations", ":id", "reject"],
              "variable": [{ "key": "id", "value": "QUOTATION_UUID" }]
            }
          }
        }
      ]
    },
    {
      "name": "4. Payments (Razorpay)",
      "item": [
        {
          "name": "Create Milestone Order (ADVANCE_50 or FINAL_50)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": \"REQUEST_UUID\",\n  \"milestone\": \"FINAL_50\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/create-order",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "create-order"]
            }
          }
        },
        {
          "name": "Verify Checkout Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"razorpayOrderId\": \"order_xxxx\",\n  \"razorpayPaymentId\": \"pay_xxxx\",\n  \"razorpaySignature\": \"hmac_sha256_signature\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/verify",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "verify"]
            }
          }
        },
        {
          "name": "Razorpay Webhook Callback",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-razorpay-signature",
                "value": "HMAC_WEBHOOK_SIGNATURE",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_xxxx\",\n        \"order_id\": \"order_xxxx\",\n        \"amount\": 75000\n      }\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/payments/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "webhook"]
            }
          }
        },
        {
          "name": "User: My Payment History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/my-history",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "my-history"]
            }
          }
        },
        {
          "name": "Admin: All Payments & Revenue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/admin/all",
              "host": ["{{baseUrl}}"],
              "path": ["payments", "admin", "all"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Real-Time Chat (REST Fallback)",
      "item": [
        {
          "name": "Get Conversation Messages",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/:requestId/messages?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["chat", ":requestId", "messages"],
              "query": [{ "key": "limit", "value": "50" }],
              "variable": [{ "key": "requestId", "value": "REQUEST_UUID" }]
            }
          }
        },
        {
          "name": "Send Message (with Optional File Attachment)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "content",
                  "value": "Here is the notarized translation reference.",
                  "type": "text"
                },
                {
                  "key": "document",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/chat/:requestId/messages",
              "host": ["{{baseUrl}}"],
              "path": ["chat", ":requestId", "messages"],
              "variable": [{ "key": "requestId", "value": "REQUEST_UUID" }]
            }
          }
        },
        {
          "name": "Mark Messages as Read (Blue Ticks)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/:requestId/read",
              "host": ["{{baseUrl}}"],
              "path": ["chat", ":requestId", "read"],
              "variable": [{ "key": "requestId", "value": "REQUEST_UUID" }]
            }
          }
        }
      ]
    },
    {
      "name": "6. Documents & Download Gatekeeper",
      "item": [
        {
          "name": "Admin: Upload Final Completed Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Certified Final Apostilled Document",
                  "type": "text"
                },
                {
                  "key": "document",
                  "type": "file",
                  "src": []
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/documents/:requestId/upload",
              "host": ["{{baseUrl}}"],
              "path": ["documents", ":requestId", "upload"],
              "variable": [{ "key": "requestId", "value": "REQUEST_UUID" }]
            }
          }
        },
        {
          "name": "Get Documents for Request (Status & Lock check)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents/request/:requestId",
              "host": ["{{baseUrl}}"],
              "path": ["documents", "request", ":requestId"],
              "variable": [{ "key": "requestId", "value": "REQUEST_UUID" }]
            }
          }
        },
        {
          "name": "SECURE GATEKEEPER: Download Document (Locked until 100% paid)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/documents/:documentId/download",
              "host": ["{{baseUrl}}"],
              "path": ["documents", ":documentId", "download"],
              "variable": [{ "key": "documentId", "value": "FINAL_DOC_UUID" }]
            }
          }
        }
      ]
    },
    {
      "name": "7. Admin Dashboard & Audit Logs",
      "item": [
        {
          "name": "Get Dashboard Statistics & Revenue",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/dashboard/stats",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "dashboard", "stats"]
            }
          }
        },
        {
          "name": "View Security Audit Trail",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/audit-logs?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "audit-logs"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    }
  ]
}
