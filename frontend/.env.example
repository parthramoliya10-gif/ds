# DSMS Frontend Environment Variables

# Application URL (Development port is 3001)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Backend API Base URL (When backend is connected)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Mock Data Toggle (true = use mock data with fake delays; false = call real backend API)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Razorpay Test Key ID (For client-side checkout integration)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mock_key_dsms
